{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "platform serve",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": ["serve"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "platform doctor",
      "type": "debugpy",
      "request": "launch",
      "module": "app.cli",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "pytest (현재 파일)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
