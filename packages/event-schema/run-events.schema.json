  "$defs": {
    "ContextCompactedData": {
      "properties": {
        "before_tokens": {
          "title": "Before Tokens",
          "type": "integer"
        },
        "after_tokens": {
          "title": "After Tokens",
          "type": "integer"
        },
        "summary_message_id": {
          "format": "uuid",
          "title": "Summary Message Id",
          "type": "string"
        }
      },
      "required": [
        "before_tokens",
        "after_tokens",
        "summary_message_id"
      ],
      "title": "ContextCompactedData",
      "type": "object"
    },
    "ContextPromptChangedData": {
      "properties": {
        "previous_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Hash"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        }
      },
      "required": [
        "prompt_hash"
      ],
      "title": "ContextPromptChangedData",
      "type": "object"
    },
    "FileChangedData": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "session_file_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session File Id"
        },
        "downloadable": {
          "title": "Downloadable",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "path",
        "size",
        "downloadable"
      ],
      "title": "FileChangedData",
      "type": "object"
    },
    "InteractionResolvedData": {
      "properties": {
        "interaction_id": {
          "title": "Interaction Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "question",
            "approval"
          ],
          "title": "Kind",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "approve",
                "reject"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "session_auto_approve": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Auto Approve"
        }
      },
      "required": [
        "interaction_id",
        "kind"
      ],
      "title": "InteractionResolvedData",
      "type": "object"
    },
    "MessageCompletedData": {
      "properties": {
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
