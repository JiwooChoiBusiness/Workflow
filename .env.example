# cp .env.example .env 로 복사한 뒤 값을 채운다. .env는 저장소에 넣지 않는다.

# 비밀값. 아래 명령을 세 번 실행해 각각 다른 값을 넣는다.
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ENCRYPTION_KEY를 잃으면 DB에 암호화해 둔 키들을 되살릴 수 없다.
ENCRYPTION_KEY=
INTERNAL_API_TOKEN=
SESSION_SECRET=

# gateway가 쓸 호스트 포트. 바인드 주소는 127.0.0.1로 고정이다.
GATEWAY_HTTP_PORT=8080

# POSTGRES_* 를 바꾸면 DATABASE_URL도 같이 맞춘다.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platform
DATABASE_URL=postgresql+asyncpg://platform:change-me@postgres:5432/platform
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO

SANDBOX_MAX_CONCURRENT=3
RUNNER_MAX_CONCURRENT_RUNS=3
SANDBOX_IDLE_TIMEOUT_SEC=1800
# 비우면 Docker 기본 런타임(runc). Linux에 gVisor를 설치했다면 runsc.
SANDBOX_RUNTIME=

# Gemini 키는 쉼표로 여러 개 적는다. 앞에서부터 쓰고 429를 받으면 다음 키로 넘어간다.
GEMINI_API_KEYS=
# 일시 오류(429, 503)일 때 이 순서로 다음 모델을 시도한다.
GEMINI_MODEL_FALLBACK=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 선택. 비워 두면 Anthropic 어댑터는 꺼진다.
ANTHROPIC_API_KEY=
