# cp .env.example .env 로 복사한 뒤 값을 채운다. .env는 저장소에 넣지 않는다.

# 비밀값. 아래 명령으로 만든 값을 넣는다.
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ENCRYPTION_KEY를 잃으면 에이전트 환경변수의 비밀값을 되살릴 수 없다.
ENCRYPTION_KEY=

# 서버. 바인드 주소는 127.0.0.1 고정이다.
SERVER_PORT=8500
LOG_LEVEL=INFO
# 데이터 폴더(DB·storage·workspaces·logs). 짧은 절대 경로를 권장한다(예: C:\wf-data). 비우면 ./data
DATA_DIR=
# 빌드된 화면. 비우면 ./apps/web/dist
WEB_DIST_DIR=
# 개발 중 vite dev 서버 출처(쉼표 구분). 운영에서는 비운다.
DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 러너. 에이전트 런, 워크플로우 런, 지식 베이스 색인 작업은 레인이 따로라 동시 수도 따로 센다.
RUNNER_MAX_CONCURRENT_RUNS=1
RUNNER_MAX_CONCURRENT_WORKFLOW_RUNS=1
RUNNER_MAX_CONCURRENT_INDEX_JOBS=1
SHUTDOWN_GRACE_SEC=20
WAITING_INPUT_TTL_HOURS=24
RUN_EVENT_RETENTION_DAYS=90
MEMORY_BUDGET_MB=300

# 샌드박스
SANDBOX_BACKEND=local
# powershell(5.1, 기본) | pwsh(7) | bash(비Windows)
SANDBOX_SHELL=powershell
# file(기본) | encoded(그룹 정책이 -File 실행을 막을 때)
SANDBOX_SHELL_MODE=file
# 비우면 플랫폼 venv의 기반 인터프리터
SANDBOX_PYTHON=
SANDBOX_MEMORY_LIMIT_MB=1024
SANDBOX_MAX_PROCESSES=64
SANDBOX_TOOL_TIMEOUT_SEC=120
SANDBOX_TOOL_MAX_TIMEOUT_SEC=900
WORKSPACE_MAX_BYTES=2147483648
SNAPSHOT_MAX_BYTES=1073741824
# off | http_writes | all_shell
APPROVAL_MODE_DEFAULT=all_shell
# 비우면 $DATA_DIR/allowlist.txt
HTTP_ALLOWLIST_FILE=
HTTP_MAX_BODY_BYTES=5242880
KEEP_RUN_SCRIPTS=false

# LLM (Gemini만). 키는 쉼표로 여러 개. 앞에서부터 쓰고 분당 한도 429를 받으면 다음 키로 넘어간다.
# 일일 한도 429는 다른 키로 넘어가지 않고 다음 모델로 간다(그 모델은 태평양 자정까지 쉰다).
# 401·403을 받은 키는 서버를 다시 띄울 때까지 쓰지 않는다.
GEMINI_API_KEYS=
# 결제를 연결한 새 프로젝트의 키 하나. 유료로 정한 지식 베이스와 그것을 쓰는 런만 이 키를 쓰고,
# 429면 기다렸다가 같은 키로 다시 보낸다(무료 키로 넘어가지 않는다).
# GEMINI_API_KEYS에 같은 키가 있으면 서버가 뜨지 않는다. 비우면 유료를 고를 수 없다.
GEMINI_PAID_API_KEY=
# 일시 오류(429, 5xx)일 때 이 순서로 다음 모델을 시도한다.
# gemini-3.7-flash는 3.8로 라우팅되는 별칭이라 기본값에서 뺐다. 넣으면 그대로 쓴다.
GEMINI_MODEL_FALLBACK=gemini-3.8-flash,gemini-3.6-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_KEY_COOLDOWN_SEC=60
# true면 가짜 어댑터(테스트·memcheck용)
# 기본 각본에서 "질문: …"으로 시작하는 메시지는 ask_user, "파일: …"은 outputs/결과.txt에 쓰는 write_file을 부른다.
LLM_FAKE=false
# 가짜 어댑터 각본 JSON({"turns": [[이벤트, ...], ...]}). 비우면 기본 각본(셸 도구 1회 + 텍스트)
LLM_FAKE_SCRIPT=
# 가짜 어댑터가 모델 호출(스텝)마다 기다리는 초(소수 가능). e2e에서 실행 중인 런을 시험할 때 쓴다.
LLM_FAKE_DELAY_SEC=0

# 워크플로우 엔진. 동시 노드 수, code 노드 시간 상한(초, 60 이하. 노드에 timeout_sec가 없을 때 쓰고
# 노드는 60초까지 따로 정할 수 있다), 런당 변수 풀 상한(MB).
# 체크포인트 간격(초)이 0이면 입력 대기 직전과 실패 때만 쓴다.
WF_MAX_PARALLEL_NODES=4
WF_CODE_TIMEOUT_SEC=30
WF_VARIABLE_POOL_MAX_MB=16
WF_CHECKPOINT_INTERVAL_SEC=0

# 하위 에이전트 호출 깊이(1~3). 지휘자가 0, 그 자식이 1, 손자가 2다. 이 깊이에 닿은 런은 call_agent가 없다.
ORCHESTRATION_MAX_DEPTH=2

# 지식 베이스. 임베딩은 분당 항목 수로 묶는다(무료 키는 100이 상한이라 그 위로 넣어도 100으로 쓴다).
# 그중 KB_EMBED_RESERVE건은 검색 질의와 청크 편집 몫이라 문서 색인은 나머지만 쓴다.
# TPM(분당 추정 토큰)은 0이면 끈다. _PAID는 유료 키의 값이다.
KB_EMBED_RPM=90
KB_EMBED_RPM_PAID=90
KB_EMBED_TPM=0
KB_EMBED_TPM_PAID=0
KB_EMBED_RESERVE=10
# 하루(태평양 자정~자정) 항목 수. 무료 키는 프로젝트 하나에 하루 1,000건이라 키를 여러 개 넣어도
# 이만큼만 보낸다. 그중 약 10%는 검색 질의 몫으로 남긴다. 0이면 세지 않는다.
KB_EMBED_RPD=1000
KB_EMBED_RPD_PAID=0
# 문서 파일 하나의 상한(MB), 문서 하나에서 꺼내 쓸 글의 상한(MB)
KB_UPLOAD_MAX_MB=50
KB_DOC_MAX_TEXT_MB=8
# 검색 결과 수(Top K)의 상한, 벡터·전문 검색이 각각 뽑는 후보 수
KB_TOP_K_MAX=20
KB_SEARCH_CANDIDATES=50
# 지우거나 끈 청크의 임베딩을 다시 쓰려고 남겨 두는 기간(일)
KB_EMBED_CACHE_DAYS=30
# 검색 질의 기록 보존(일). 0이면 기록하지 않는다.
KB_QUERY_LOG_DAYS=90
# 색인 파일(data/knowledge/index.db) 연결마다 쓰는 SQLite 캐시(KB). 메모리가 빠듯하면 4000으로 내린다.
KB_INDEX_CACHE_KB=8000
# 유닛이 이보다 많은 지식 베이스는 비트 양자화로 후보를 먼저 추린다(아직 구현 없음).
KB_BIT_CANDIDATES_THRESHOLD=200000

# Text2SQL 데이터 소스. 노드·도구가 받는 행 수의 상한, 새 데이터 소스의 기본 시간 상한(초, 60까지),
# 새 데이터 소스의 메모리 기본값이자 질의·준비 프로세스의 상한(MB, DuckDB는 그 절반을 쓴다),
# 데이터 소스 파일 하나의 상한(MB). 시간·메모리를 바꿔도 이미 만든 데이터 소스에는 소급하지 않는다
# (데이터 소스의 설정 탭에서 고친다). SQL 질의 기록 보존 기간은 KB_QUERY_LOG_DAYS를 같이 쓴다.
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SEC=30
SQL_MEMORY_MB=512
SQL_UPLOAD_MAX_MB=200
# DuckDB 런타임 설치(약 250MB 받기) 전체의 시간 상한(초). 넘으면 설치를 멈추고 실패로 둔다.
SQL_RUNTIME_INSTALL_TIMEOUT_SEC=600

# E2B 백엔드(미구현, 자리만)
E2B_API_KEY=
E2B_TEMPLATE=
